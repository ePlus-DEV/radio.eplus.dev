{
  "name": "eplus-onair",
  "version": "2.0.0",
  "repository": "https://github.com/ePlus-DEV/radio.eplus.dev",
  "description": "ePlus OnAir — Listen Beyond Borders. Live radio from around the world.",
  "author": "David Nguyen",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "prebuild": "node scripts/build-station-search-index.mjs && node scripts/generate-social-preview.mjs && node scripts/generate-station-og-images.mjs",
    "dev": "nuxt dev",
    "predev": "node scripts/build-station-search-index.mjs && node scripts/generate-station-og-images.mjs",
    "generate": "nuxt generate",
    "pregenerate": "node scripts/build-station-search-index.mjs && node scripts/generate-social-preview.mjs && node scripts/generate-station-og-images.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node --test tests/*.test.mjs",
    "catalog:classify": "node scripts/audit-radio-classification.mjs",
    "test:ui": "playwright test",
    "generate:site": "node scripts/generate-site.mjs",
    "generate:images": "node scripts/generate-station-og-images.mjs --images-only",
    "audit:report": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@iconify-json/lucide": "^1.2.151",
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/algolia": "^1.11.2",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@vesp/nuxt-fontawesome": "^2.0.0",
    "dayjs-nuxt": "^2.1.11",
    "hls.js": "^1.7.4",
    "nuxt": "4.6.4",
    "nuxt-site-config": "^5.0.3",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.4",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "24.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  },
  "overrides": {
    "fontless": {
      "esbuild": "0.28.2"
    },
    "@intlify/vue-i18n-extensions": "9.0.0",
    "@intlify/core": "11.4.14",
    "@intlify/core-base": "11.4.14",
    "@intlify/devtools-types": "11.4.14",
    "@intlify/message-compiler": "11.4.14",
    "@intlify/shared": "11.4.14",
    "vue-i18n": "11.4.14",
    "follow-redirects": "1.16.2",
    "glob": "14.0.4",
    "minimatch": "11.0.7",
    "readdir-glob": "4.0.0"
  }
}
