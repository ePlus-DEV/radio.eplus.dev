# Only browser-safe settings belong in NUXT_PUBLIC_*; these are exposed to visitors.
# Public-safe example. Keep all tokens, write/admin keys, and provider secrets out of Git.
#SERVER_PRESET=digital-oceans
WEBSITE_NAME="ePlus OnAir — Listen Beyond Borders."
DESCRIPTION="ePlus OnAir — Listen Beyond Borders. Discover and listen to live radio stations worldwide."
FANPAGE="https://www.facebook.com/eplus.dev"
NUXT_PUBLIC_FACEBOOK="https://www.facebook.com/hoangsvit"
NUXT_PUBLIC_GITHUB="https://github.com/hoangsvit"
NUXT_PUBLIC_X="https://www.instagram.com/hoang.it/"
GROUP_FACEBOOK="https://www.facebook.com/groups/radio.eplus.dev"
NUXT_PUBLIC_COPYRIGHT="https://eplus.dev"
EMAIL_CONTACT="admin@eplus.dev"
## Pin_Channel_Favorites: viet-nam | singapore | united-kingdom | australia
NUXT_PUBLIC_PIN_CHANNEL_FAVORITES="viet-nam"
NUXT_PUBLIC_CORS_SERVER_1="https://cors-anywhere.eplus.dev/"
CORS_SERVER_2="https://e-cros.herokuapp.com/"
CORS_SERVER_3="https://cors.eplus.dev/"
CORS_SERVER_4="https://e-cors.netlify.app/"
NUXT_PUBLIC_API_FRESHPING=
# Algolia
ALGOLIA_APPLICATION_ID=
# Optional: use only an index-restricted Algolia SEARCH key, never an Admin/Write key.
ALGOLIA_API_KEY=
# ALGOLIA_APPLICATION_ID=
# ALGOLIA_API_KEY=
# Zing Server
NUXT_PUBLIC_API_ZING_LIVE_STREAM_PROGRAM_DETAIL=
NUXT_PUBLIC_API_ZING_GET_LYRIC=
# Cloudinary
CLOUDINARY_NAME="eplus-dev"
# Cloudinary upload/API credentials belong in ignored local .env or environment secrets.
NUXT_PUBLIC_CLOUDINARY_BASE_URL="http://localhost:3000"
# Sitemap
NUXT_PUBLIC_SITE_URL="http://localhost:3000"