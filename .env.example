# Only browser-safe settings belong in NUXT_PUBLIC_*; these are exposed to visitors.
# Public-safe example. Keep all tokens, write/admin keys, and provider secrets out of Git.
#SERVER_PRESET=digital-oceans
WEBSITE_NAME="ePlus OnAir — Listen Beyond Borders."
DESCRIPTION="ePlus OnAir — Listen Beyond Borders. Discover and listen to live radio stations worldwide."
FANPAGE="https://www.facebook.com/eplus.dev"
NUXT_PUBLIC_FACEBOOK="https://www.facebook.com/hoangsvit"
NUXT_PUBLIC_GITHUB="https://github.com/hoangsvit"
NUXT_PUBLIC_X="https://www.instagram.com/hoang.it/"
GROUP_FACEBOOK="https://www.facebook.com/groups/radio.eplus.dev"
NUXT_PUBLIC_COPYRIGHT="https://eplus.dev"
EMAIL_CONTACT="admin@eplus.dev"
## Pin_Channel_Favorites: viet-nam | singapore | united-kingdom | australia
NUXT_PUBLIC_PIN_CHANNEL_FAVORITES="viet-nam"
# Public HTTPS CORS proxy origin shared by Country Radio and TuneIn Apple Radio.
# Set this key separately in GitHub Environments (preview/staging/production) for Pages builds.
# This is an example, not a hardcoded fallback in application code.
NUXT_PUBLIC_CORS_SERVER_1="https://cors-anywhere.eplus.dev/"
# Optional: exact HTTPS API URL on your own authorized ePlus backend.
# Must implement the contract in docs/global-radio-resolver.md.
# Leave empty until the provider grants playback/stream rights.
# Do not point directly to Tune.ashx or a generic open CORS proxy.
NUXT_PUBLIC_GLOBAL_RADIO_RESOLVER_URL=
CORS_SERVER_2="https://e-cros.herokuapp.com/"
CORS_SERVER_3="https://cors.eplus.dev/"
CORS_SERVER_4="https://e-cors.netlify.app/"
NUXT_PUBLIC_API_FRESHPING=
# Algolia
ALGOLIA_APPLICATION_ID=
# Optional: use only an index-restricted Algolia SEARCH key, never an Admin/Write key.
ALGOLIA_API_KEY=
# ALGOLIA_APPLICATION_ID=
# ALGOLIA_API_KEY=
# Zing Server
NUXT_PUBLIC_API_ZING_LIVE_STREAM_PROGRAM_DETAIL=
NUXT_PUBLIC_API_ZING_GET_LYRIC=
# Cloudinary
CLOUDINARY_NAME="eplus-dev"
# Cloudinary upload/API credentials belong in ignored local .env or environment secrets.
NUXT_PUBLIC_CLOUDINARY_BASE_URL="http://localhost:3000"
# Site URL defaults to localhost for local development; GitHub Environment Variables override it during static builds.
# production: https://radio.eplus.dev
# staging: https://stg.radio.eplus.dev
# preview: https://preview.radio.eplus.dev/pr-preview/pr-N (computed by workflow)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional browser-tab / site title for this environment; Production defaults to ePlus OnAir.
# Staging defaults to ePlus OnAir — Staging; Preview defaults to ePlus OnAir — Preview.
# Set NUXT_PUBLIC_SITE_NAME independently in each GitHub Environment when desired.
# NUXT_PUBLIC_SITE_NAME="ePlus OnAir"

# Deployment variables belong in GitHub Settings, NOT the local .env file:
# GitHub Environments: production / staging / preview
# Repository Actions Variables: PAGES_STAGING_READY and PAGES_PREVIEW_READY
# Each GitHub Environment stores its own PAGES_DEPLOY_TOKEN secret.
